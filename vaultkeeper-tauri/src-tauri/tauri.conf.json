{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultKeeper",
  "identifier": "com.vaultkeeper.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VaultKeeper",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "transparent": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": ["'self'", "data:"],
        "img-src": ["'self'", "data:", "https:"],
        "connect-src": ["'self'", "https:"],
        "media-src": ["'self'", "data:", "https:"]
      },
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["bin/vk_host", "bin/vk_host.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "PortugueseBR"],
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/GabrielSantos23/VaultKeeper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwMzkxQzk1MUM5QUVFQkMKUldTODdwb2NsUnc1RUdRaUg0UGZINU9ZRmREN2RkcDVKK3hBSVhLUVdCb20zSjVObGQrdjFQcDEK"
    }
  }
}
